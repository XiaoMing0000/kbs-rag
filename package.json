{
	"name": "kbs-rag",
	"version": "1.0.0",
	"description": "知识库构建 RAG 助手",
	"main": "index.js",
	"packageManager": "pnpm@9.15.0",
	"scripts": {
		"db:init": "prisma migrate dev",
		"db:generate": "prisma generate",
		"dev": "nodemon",
		"dev:unwatch": "tsx src/entry/index.ts",
		"build": "node ./config/esbuild.config.mts",
		"start": "node ./dist/index.js",
		"lint": "eslint && tsc --noEmit",
		"format": "prettier --write .",
		"prepare": "simple-git-hooks"
	},
	"devDependencies": {
		"@types/node": "^25.9.3",
		"@types/pg": "^8.23.1",
		"esbuild": "^0.28.1",
		"eslint": "^10.5.0",
		"jiti": "^2.7.0",
		"nodemon": "^3.1.14",
		"prettier": "^3.8.4",
		"prisma": "^7.9.1",
		"simple-git-hooks": "^2.13.1",
		"ts-node": "^10.9.2",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.61.1"
	},
	"dependencies": {
		"@langchain/core": "^1.2.8",
		"@langchain/openai": "^1.5.8",
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"dotenv": "^17.4.2",
		"langchain": "^1.5.9",
		"pg": "^8.23.0",
		"zod": "^4.4.3"
	},
	"simple-git-hooks": {
		"pre-commit": "npm run lint && npm run format -- --check",
		"pre-push": "npm run format"
	},
	"engines": {
		"node": ">=22.13.0",
		"pnpm": ">=9.15.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/XiaoMing0000/kbs-rag.git"
	},
	"keywords": [
		"rag",
		"embedding",
		"markdown",
		"knowledge-assistant"
	],
	"bugs": {
		"url": "https://github.com/XiaoMing0000/kbs-rag/issues"
	},
	"homepage": "https://github.com/XiaoMing0000/kbs-ragCode#readme",
	"author": "xiaoming0000",
	"license": "MIT",
	"nodemonConfig": {
		"watch": [
			"src"
		],
		"ext": "ts",
		"exec": "tsx src/entry/index.ts",
		"ignore": [
			"./doc",
			"./dist",
			"./logs",
			"./node_modules"
		],
		"verbose": true
	}
}
