{
	"name": "kbs-rag",
	"version": "1.0.0",
	"description": "知识库构建 RAG 助手",
	"type": "module",
	"main": "index.js",
	"license": "MIT",
	"author": "xiaoming0000",
	"packageManager": "pnpm@9.15.0",
	"engines": {
		"node": ">=22.13.0",
		"pnpm": ">=9.15.0"
	},
	"scripts": {
		"db:init": "prisma migrate dev",
		"db:generate": "prisma generate",
		"dev": "nodemon",
		"dev:unwatch": "tsx src/entry/index.ts",
		"build": "node ./config/esbuild.config.mts",
		"start": "node ./dist/index.js",
		"tsc": "tsc",
		"tsc:check": "tsc --noEmit",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"lint:check": "oxlint && pnpm run tsc:check",
		"prepare": "simple-git-hooks"
	},
	"dependencies": {
		"@langchain/core": "^1.2.8",
		"@langchain/openai": "^1.5.8",
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"dotenv": "^17.4.2",
		"langchain": "^1.5.9",
		"pg": "^8.23.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^25.9.3",
		"@types/pg": "^8.23.1",
		"esbuild": "^0.28.1",
		"jiti": "^2.7.0",
		"nodemon": "^3.1.14",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"prisma": "^7.9.1",
		"simple-git-hooks": "^2.13.1",
		"ts-node": "^10.9.2",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm exec lint-staged",
		"commit-msg": "node scripts/check-changelog.js \"$1\"",
		"pre-push": "pnpm run fmt:check && pnpm run lint:check"
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx,json,jsonc}": [
			"oxfmt",
			"pnpm run lint:fix"
		]
	},
	"keywords": [
		"rag",
		"embedding",
		"markdown",
		"knowledge-assistant"
	],
	"homepage": "https://github.com/XiaoMing0000/kbs-ragCode#readme",
	"bugs": {
		"url": "https://github.com/XiaoMing0000/nodejs-falsework/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/XiaoMing0000/nodejs-falsework.git"
	}
}
